// ============================================================
// Rule Name:    Service Account Interactive Login
// Description:  Detects service accounts logging in interactively
//               (at a console or via RDP). Service accounts should
//               only authenticate via specific logon types (e.g.
//               Service, Batch). Interactive logins indicate
//               potential credential theft or insider misuse.
// Tactic:       Privilege Escalation, Lateral Movement
// Technique:    T1078.002 - Valid Accounts: Domain Accounts
//               T1021.001 - Remote Services: RDP
// Severity:     High
// Frequency:    Every 15 minutes
// Lookback:     15 minutes
// Data Source:  SecurityEvent (Windows), SigninLogs (Azure AD)
// ============================================================

// Define your service account naming conventions
// Adjust these patterns to match your environment
let ServiceAccountPatterns = dynamic([
    "svc_",
    "svc-",
    "_svc",
    "-svc",
    "service_",
    "sa_",
    "sa-"
]);

// Interactive logon types to flag
// 2 = Interactive (console), 10 = RemoteInteractive (RDP)
let InteractiveLogonTypes = dynamic([2, 10]);

// Known hosts where service account interactive login is expected
// (e.g., dedicated admin workstations) — add to reduce false positives
let AllowedHosts = dynamic([
    // "admin-ws-01",
    // "jumpbox-01"
]);


// --- Variant 1: Windows Security Events (Event ID 4624) ---

SecurityEvent
| where TimeGenerated >= ago(15m)
| where EventID == 4624                          // Successful logon
| where LogonType in (InteractiveLogonTypes)
| where AccountType == "User"
// Match service account naming patterns
| where TargetUserName has_any (ServiceAccountPatterns)
// Exclude computer accounts (end with $)
| where not(TargetUserName endswith "$")
// Exclude allowed hosts
| where not(Computer in~ (AllowedHosts))
| extend
    LogonTypeDesc = case(
        LogonType == 2,  "Interactive (Console)",
        LogonType == 10, "RemoteInteractive (RDP)",
        "Other"
    )
| project
    TimeGenerated,
    Computer,
    TargetUserName,
    TargetDomainName,
    LogonType,
    LogonTypeDesc,
    IpAddress,
    WorkstationName,
    ProcessName
| order by TimeGenerated desc


// --- Variant 2: Azure AD Service Account Interactive Login ---
// Flags service principals or shared accounts signing in via browser/interactive flow

// SigninLogs
// | where TimeGenerated >= ago(15m)
// | where ResultType == "0"                      // Successful only
// | where UserPrincipalName has_any (ServiceAccountPatterns)
// | where ClientAppUsed in (
//     "Browser",
//     "Mobile Apps and Desktop clients"
// )
// | where not(AppDisplayName in (
//     // Whitelist any apps where interactive login is expected
// ))
// | project
//     TimeGenerated,
//     UserPrincipalName,
//     IPAddress,
//     Location,
//     AppDisplayName,
//     ClientAppUsed,
//     DeviceDetail,
//     ConditionalAccessStatus
// | order by TimeGenerated desc


// ============================================================
// Alert Logic Notes:
// - Service accounts authenticating interactively is a high-
//   fidelity indicator of either:
//     1. Credential theft (attacker using stolen svc account creds)
//     2. Insider misuse (admin logging in as service account)
//     3. Misconfigured automation using wrong account
// - Tune ServiceAccountPatterns to match YOUR naming convention.
//   Most orgs use a prefix like svc_ or sa- for service accounts.
// - Cross-reference with:
//     * Logon from unusual IP/location
//     * Subsequent privilege escalation attempts (Event 4672)
//     * Lateral movement to other hosts
// - Event ID 4672 (Special privileges assigned) fired alongside
//   4624 indicates the account has admin rights — escalate priority.
// - MITRE reference: https://attack.mitre.org/techniques/T1078/002/
// ============================================================
