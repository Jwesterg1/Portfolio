// | where TimeGenerated >= ago(1h)
// | where Source == "Microsoft-Windows-Sysmon"
// | where EventID == 1                           // Process create
// | extend EventData = parse_xml(EventData)
// | extend
//     Hashes  = tostring(EventData.DataItem.EventData.Data[17]["#text"]),
//     Image   = tostring(EventData.DataItem.EventData.Data[4]["#text"]),
//     User    = tostring(EventData.DataItem.EventData.Data[12]["#text"])
// | extend SHA256 = extract(@'SHA256=([A-Fa-f0-9]{64})', 1, Hashes)
// | join kind=inner (ThreatHashes) on $left.SHA256 == $right.IndicatorValue
// | project
//     TimeGenerated,
//     Computer,
//     User,
//     Image,
//     SHA256,
//     ThreatType,
//     Source,
//     Confidence
// | order by TimeGenerated desc


// ============================================================
// Recommended Threat Intel Sources (free):
//
// CISA Known Exploited Vulnerabilities (KEV):
//   https://www.cisa.gov/known-exploited-vulnerabilities-catalog
//
// abuse.ch Feodo Tracker (C2 IPs):
//   https://feodotracker.abuse.ch/downloads/ipblocklist.txt
//
// abuse.ch MalwareBazaar (file hashes):
//   https://bazaar.abuse.ch/export/
//
// AlienVault OTX (multi-type IOCs):
//   https://otx.alienvault.com/
//
// Emerging Threats (network IOCs):
//   https://rules.emergingthreats.net/
//
// Alert Logic Notes:
// - Watchlist-based detection scales easily — add new IOCs
//   without changing the KQL rule.
// - Set ExpirationDate on IOCs to auto-age out stale indicators.
// - Confidence field lets you tune alert severity dynamically.
// - MITRE reference: https://attack.mitre.org/techniques/T1071/
// ============================================================
