// ============================================================
// Rule Name:    Threat Intel Watchlist Match
// Description:  Correlates network activity, sign-in logs, and
//               security events against a Sentinel watchlist of
//               known malicious indicators (IPs, domains, hashes).
//               Watchlist is populated from external threat intel
//               feeds (e.g. CISA KEV, abuse.ch, AlienVault OTX).
// Tactic:       Multiple (depends on indicator type)
// Technique:    T1071 - Application Layer Protocol
//               T1566 - Phishing
//               T1190 - Exploit Public-Facing Application
// Severity:     High
// Frequency:    Every 1 hour
// Lookback:     1 hour
// Data Source:  SigninLogs, SecurityEvent, CommonSecurityLog
//               _GetWatchlist() - Sentinel Watchlist
// ============================================================

// ----------------------------------------------------------
// WATCHLIST SETUP:
// Create a Sentinel Watchlist named "ThreatIntelIndicators"
// with the following columns:
//   IndicatorType  (IP, Domain, FileHash, URL)
//   IndicatorValue (the actual IOC)
//   ThreatType     (Malware, C2, Phishing, Scanner, etc.)
//   Confidence     (High, Medium, Low)
//   Source         (e.g. CISA, abuse.ch, OTX, Internal)
//   ExpirationDate (optional — for time-bound IOCs)
// ----------------------------------------------------------


// --- Variant 1: Malicious IP match against Sign-In Logs ---

let ThreatIPs =
    _GetWatchlist('ThreatIntelIndicators')
    | where IndicatorType == "IP"
    | where Confidence in ("High", "Medium")
    | project IndicatorValue, ThreatType, Source, Confidence;

SigninLogs
| where TimeGenerated >= ago(1h)
| join kind=inner (ThreatIPs) on $left.IPAddress == $right.IndicatorValue
| project
    TimeGenerated,
    UserPrincipalName,
    IPAddress,
    ThreatType,
    Source,
    Confidence,
    Location,
    AppDisplayName,
    ResultType,
    ResultDescription
| order by TimeGenerated desc


