// | where ResultType !in ("50076", "50079")      // Exclude MFA challenges
// | summarize
//     FailedAttempts = count(),
//     TargetAccounts = make_set(UserPrincipalName),
//     FirstAttempt = min(TimeGenerated),
//     LastAttempt = max(TimeGenerated)
//     by IPAddress
